{% set copy = landingProduct[lang] %}
<main id="content" class="ocx-home">
  <section class="ocx-hero" aria-labelledby="hero-title">
    <picture class="ocx-hero-art" aria-hidden="true">
      <source srcset="{{ assetPrefix }}images/hero-engine.webp" type="image/webp" />
      <img src="{{ assetPrefix }}images/hero-engine.png" alt="{{ copy.hero.artworkAlt }}" width="1717" height="916" fetchpriority="high" />
    </picture>
    <div class="ocx-hero-shade" aria-hidden="true"></div>
    <div class="ocx-hero-copy">
      <p class="ocx-kicker">{{ copy.hero.eyebrow }}</p>
      <h1 id="hero-title">{{ copy.hero.title }}</h1>
      <p class="ocx-hero-lead">{{ copy.hero.description }}</p>
      <div class="ocx-hero-actions">
        <a class="ocx-button ocx-button--primary" href="{% if lang == 'ko' %}/codexmux/ko/docs/quickstart/{% else %}/codexmux/docs/quickstart/{% endif %}">{{ copy.hero.primaryAction }} <span aria-hidden="true">→</span></a>
        <a class="ocx-button ocx-button--glass" href="https://github.com/HardcoreMonk/codexmux" target="_blank" rel="noopener">{{ copy.hero.secondaryAction }}</a>
      </div>
      <div class="ocx-hero-chips" aria-label="Product areas">{% for chip in copy.hero.chips %}<span>{{ chip }}</span>{% endfor %}</div>
      <p class="ocx-hero-note">{{ copy.hero.note }}</p>
    </div>
  </section>

  <section class="ocx-quickstart" aria-labelledby="quickstart-title">
    <div class="ocx-quickstart-copy">
      <p class="ocx-kicker">{{ copy.quickstart.eyebrow }}</p>
      <h2 id="quickstart-title">{% for line in copy.quickstart.title %}<span>{{ line }}</span>{% endfor %}</h2>
      <p>{{ copy.quickstart.description }}</p>
      <div class="ocx-version-note"><span>{{ copy.quickstart.versionNote }}</span><strong>codexmux@{{ copy.publicVersion }}</strong><small>source/live {{ copy.sourceVersion }}</small></div>
    </div>
    <div class="ocx-terminal-card">
      <div class="ocx-terminal-bar"><span></span><span></span><span></span><strong>bash</strong></div>
      <pre>{% for line in copy.quickstart.lines %}<code><b>$</b> {{ line.command }} <em># {{ line.note }}</em></code>{% endfor %}</pre>
      <button type="button" class="ocx-copy" data-copy-text="{{ copy.installCommand }}" aria-label="{% if lang == 'ko' %}설치 명령 복사{% else %}Copy install command{% endif %}">⧉</button>
      <a href="{% if lang == 'ko' %}/codexmux/ko/docs/quickstart/{% else %}/codexmux/docs/quickstart/{% endif %}">{{ copy.quickstart.guide }} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="ocx-proof" aria-labelledby="proof-title">
    <div class="ocx-section-heading">
      <p class="ocx-kicker">{{ copy.proof.eyebrow }}</p>
      <h2 id="proof-title">{{ copy.proof.title }}</h2>
      <p>{{ copy.proof.description }}</p>
    </div>

    <div class="ocx-app-frame" role="img" aria-label="{% if lang == 'ko' %}Workspace, Sessions, Governance의 선택 상태가 구분된 codexmux 제품 화면 예시{% else %}codexmux product preview with distinct Workspace, Sessions and Governance selection states{% endif %}">
      <div class="ocx-app-topbar" aria-hidden="true">
        <span class="ocx-app-brand"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>codexmux</span>
        <nav aria-label="App areas">{% for area in copy.preview.areas %}<span{% if area == 'Sessions' %} class="is-current" aria-current="page"{% endif %}>{{ area }}</span>{% endfor %}</nav>
        <span class="ocx-worker-state"><i aria-hidden="true"></i>{{ copy.preview.ready }}</span>
      </div>
      <div class="ocx-app-grid" aria-hidden="true">
        <aside class="ocx-app-sidebar">
          <div class="ocx-preview-label">Session Catalog</div>
          <div class="ocx-preview-search">⌕ <span>{{ copy.preview.search }}</span></div>
          <div class="ocx-preview-filter">{{ copy.preview.filter }}</div>
          {% for result in copy.preview.results %}<article{% if loop.first %} class="is-selected"{% endif %}><div><span>{{ result.project }}</span><em>{{ result.state }}</em></div><strong>{{ result.title }}</strong><small>{{ result.meta }}</small></article>{% endfor %}
        </aside>
        <section class="ocx-app-replay">
          <header><div><span>{{ copy.preview.replay }}</span><strong>{{ copy.preview.replayTitle }}</strong></div><span>•••</span></header>
          <div class="ocx-timeline">{% for item in copy.preview.timeline %}<div><i aria-hidden="true"></i><span>{{ item }}</span><small>0{{ loop.index }}:2{{ loop.index }}</small></div>{% endfor %}</div>
          <div class="ocx-command-line"><span>$</span><code>corepack pnpm test</code><strong>{{ copy.preview.checks }}</strong></div>
        </section>
        <aside class="ocx-app-context">
          <div class="ocx-preview-label">{{ copy.preview.context }}</div>
          <strong>{{ copy.preview.project }}</strong>
          <div>{% for document in copy.preview.documents %}<span>{{ document }}</span>{% endfor %}</div>
          <p>◇ {{ copy.preview.guarded }}</p>
        </aside>
      </div>
    </div>
    <p class="ocx-proof-caption">{{ copy.proof.caption }}</p>
  </section>

  <section class="ocx-capabilities" aria-labelledby="capabilities-title">
    <div class="ocx-section-heading">
      <p class="ocx-kicker">{{ copy.capabilities.eyebrow }}</p>
      <h2 id="capabilities-title">{{ copy.capabilities.title }}</h2>
      <p>{{ copy.capabilities.description }}</p>
    </div>
    <div class="ocx-bento">
      {% for card in copy.capabilities.cards %}
      <article class="ocx-bento-card ocx-bento-card--{{ card.key }}{% if card.size %} is-{{ card.size }}{% endif %}">
        <div class="ocx-card-label"><span aria-hidden="true">{% if card.key == 'sessions' %}⌕{% elif card.key == 'governance' %}◇{% elif card.key == 'workspace' %}▦{% elif card.key == 'reconnect' %}↻{% elif card.key == 'runtime' %}⌁{% elif card.key == 'guarded' %}□{% elif card.key == 'local' %}◉{% else %}文{% endif %}</span>{{ card.label }}</div>
        <h3>{{ card.title }}</h3>
        <p>{{ card.text }}</p>
        <div class="ocx-card-visual" aria-hidden="true">
          {% if card.key == 'sessions' %}<span class="ocx-mini-search">⌕ project:codexmux tag:release</span><span class="ocx-mini-row is-active"><i></i> Navigation clarity <b>Pinned</b></span><span class="ocx-mini-row"><i></i> Runtime recovery <b>Replay</b></span>
          {% elif card.key == 'governance' %}<span>AGENTS.md <b>Guidance</b></span><span>CONTEXT.md <b>Indexed</b></span><span>Lifecycle <b>Operate</b></span><em>Preview required before write</em>
          {% elif card.key == 'workspace' %}<span><i class="is-busy"></i>Busy</span><span><i class="is-input"></i>Needs input</span><span><i class="is-done"></i>Completed</span>
          {% elif card.key == 'reconnect' %}<span>terminal</span><i>→</i><span>reconnect</span><i>→</i><strong>same session</strong>
          {% elif card.key == 'runtime' %}<span>Terminal <i></i></span><span>Timeline <i></i></span><span>Storage <i></i></span><span>Governance <i></i></span>
          {% elif card.key == 'guarded' %}<span>Preview</span><i>→</i><span>Confirm</span><i>→</i><span>Journal</span><i>→</i><strong>Rollback</strong>
          {% elif card.key == 'local' %}<code>runtime-v2/state.db</code><code>session-catalog/index.db</code><code>governance/index.db</code>
          {% else %}<strong>한국어</strong><i>/</i><strong>English</strong><span>focus-visible · reduced-motion · 44px</span>{% endif %}
        </div>
        {% if card.href %}<a href="{{ card.href }}">{{ card.link }} <span aria-hidden="true">→</span></a>{% endif %}
      </article>
      {% endfor %}
    </div>
  </section>

  <section class="ocx-doc-map" aria-labelledby="docs-title">
    <div class="ocx-section-heading">
      <p class="ocx-kicker">{{ copy.docs.eyebrow }}</p>
      <h2 id="docs-title">{{ copy.docs.title }}</h2>
    </div>
    <div class="ocx-doc-grid">{% for group in copy.docs.groups %}<div><h3>{{ group.title }}</h3><ul>{% for link in group.links %}<li><a href="{{ link.href }}">{{ link.label }}</a></li>{% endfor %}</ul></div>{% endfor %}</div>
    <a class="ocx-doc-action" href="{% if lang == 'ko' %}/codexmux/ko/docs/{% else %}/codexmux/docs/{% endif %}">{{ copy.docs.action }} <span aria-hidden="true">→</span></a>
  </section>
</main>
