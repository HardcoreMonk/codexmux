<div class="doc-search-overlay" data-search-overlay hidden>
  <div class="doc-search-backdrop" data-search-close></div>
  <div class="doc-search-modal" id="site-search-dialog" role="dialog" aria-modal="true" aria-labelledby="site-search-label">
    <div class="doc-search-field">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <label class="sr-only" id="site-search-label" for="site-search-input">{{ shellSearchLabel }}</label>
      <input id="site-search-input" type="search" class="doc-search-input" data-search-input placeholder="{{ shellSearchPlaceholder }}" aria-label="{{ shellSearchLabel }}" autocomplete="off" spellcheck="false" data-locale="{{ shellLocale }}" />
      <button type="button" class="doc-search-esc" data-search-close aria-label="{{ shellCloseLabel }}">Esc</button>
    </div>
    <div class="doc-search-results" data-search-results role="listbox" aria-label="{{ shellSearchResultsLabel }}"></div>
    <div class="doc-search-footer"><span><kbd>↑</kbd><kbd>↓</kbd> {{ shellNavigateLabel }}</span><span><kbd>↵</kbd> {{ shellOpenLabel }}</span><span><kbd>Esc</kbd> {{ shellCloseLabel }}</span></div>
  </div>
</div>
