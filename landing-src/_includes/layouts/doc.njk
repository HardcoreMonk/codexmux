{%- set loc = locale or 'en' %}
{%- set t = i18n[loc] %}
{%- set docsBasePath = '/docs/' if loc == 'en' else '/' + loc + '/docs/' %}
{%- set docsUrlPrefix = '/codexmux' + docsBasePath %}
{%- set currentGuide = docsNav | findDocsItem(page.fileSlug) %}
<!DOCTYPE html>
<html lang="{{ loc }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>
    (function () {
      var preference = 'auto';
      try {
        var stored = localStorage.getItem('codexmux-site-theme');
        if (stored === 'light' || stored === 'dark') preference = stored;
      } catch (_) {}
      document.documentElement.dataset.themePreference = preference;
      document.documentElement.dataset.theme = preference === 'auto'
        ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        : preference;
    })();
  </script>
  <title>{{ title }} — codexmux docs</title>
  <meta name="description" content="{{ description }}" />
  <meta property="og:title" content="{{ title }} — codexmux docs" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:type" content="article" />
  <meta property="og:url" content="{{ site.baseUrl }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.baseUrl }}/images/og-image.png" />
  <link rel="canonical" href="{{ site.baseUrl }}{{ page.url }}" />
{%- for language in locales %}
{%- if not currentGuide or currentGuide | guideAvailable(language.code) %}
  <link rel="alternate" hreflang="{{ language.htmlLang }}" href="{{ site.baseUrl }}{{ page.url | localizeDocsUrl(language.code) | replace('/codexmux', '') }}" />
{%- endif %}
{%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.baseUrl }}{{ page.url | localizeDocsUrl('en') | replace('/codexmux', '') }}" />
  <link rel="icon" href="/codexmux/images/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/codexmux/images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/codexmux/images/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/codexmux/images/apple-touch-icon.png" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f8f6" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0e0f" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" />
  <link rel="stylesheet" href="/codexmux/style.css?v={{ site.assetVersion.css }}" />
  <link rel="stylesheet" href="/codexmux/style-docs.css?v={{ site.assetVersion.docsCss }}" />
</head>
<body class="doc-body">
{%- set shellLocale = loc %}
{%- set shellIsDocs = true %}
{%- set shellSearchLabel = t.searchLabel %}
{%- set shellSearchPlaceholder = t.searchPlaceholder %}
{%- set shellSearchResultsLabel = t.searchLabel %}
{%- set shellNavigateLabel = t.navigate %}
{%- set shellOpenLabel = t.open %}
{%- set shellCloseLabel = t.close %}
{% include "chrome/site-header.njk" %}

  {%- set currentGroup = docsNav | findDocsGroup(page.fileSlug, loc) %}
  <div class="doc-mobile-header">
    <button type="button" class="doc-menu-btn" data-sidebar-open aria-label="{{ t.docsBrand }}" title="{{ t.docsBrand }}" aria-controls="doc-sidebar" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11a2 2 0 0 1 2 2v15a2 2 0 0 0-2-2H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v17a2 2 0 0 1 2-2h2.5a2.5 2.5 0 0 1 2.5 2.5z"/></svg>
    </button>
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      {%- if currentGroup %}<span class="doc-breadcrumb-group">{{ currentGroup }}</span><span class="doc-breadcrumb-sep">›</span>{%- endif %}
      <span class="doc-breadcrumb-current">{{ title }}</span>
    </nav>
  </div>

  <div class="doc-sidebar-backdrop" data-sidebar-backdrop hidden></div>
  <div class="doc-shell">
    <aside class="doc-sidebar" id="doc-sidebar">
      <button type="button" class="doc-sidebar-close" data-sidebar-close aria-label="{{ t.close }}">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M6 18L18 6"/></svg>
      </button>
      <nav class="doc-sidebar-inner" aria-label="Documentation">
{%- for group in docsNav %}
{%- if group | guideAvailable(loc) %}
        <div class="doc-group">
          <div class="doc-group-label">{{ group.group[loc] or group.group.en }}</div>
{%- for item in group.items %}
{%- if item | guideAvailable(loc) %}
          <a href="{{ docsUrlPrefix }}{{ item.slug }}/" class="doc-link{% if page.url == docsBasePath + item.slug + '/' %} is-active{% endif %}">{{ item.label[loc] or item.label.en }}</a>
{%- endif %}
{%- endfor %}
        </div>
{%- endif %}
{%- endfor %}
      </nav>
    </aside>

    <main class="doc-main">
      <article class="doc-article">
        <header class="doc-header">
          <div class="doc-eyebrow">{{ eyebrow or t.docsBrand }}</div>
          <h1 class="doc-title">{{ title }}</h1>
          {%- if description %}<p class="doc-subtitle">{{ description }}</p>{%- endif %}
        </header>
        <div class="doc-content" data-doc-content>{{ content | safe }}</div>

        {%- set neighbors = docsFlat | docsNeighbors(page.fileSlug, loc) %}
        {%- if neighbors.prev or neighbors.next %}
        <nav class="doc-pagination" aria-label="{{ t.pagination }}">
          {%- if neighbors.prev %}<a href="{{ docsUrlPrefix }}{{ neighbors.prev.slug }}/" class="doc-pag-link doc-pag-prev"><span class="doc-pag-dir">{{ t.previous }}</span><span class="doc-pag-title">{{ neighbors.prev.label[loc] or neighbors.prev.label.en }}</span></a>{%- else %}<span></span>{%- endif %}
          {%- if neighbors.next %}<a href="{{ docsUrlPrefix }}{{ neighbors.next.slug }}/" class="doc-pag-link doc-pag-next"><span class="doc-pag-dir">{{ t.next }}</span><span class="doc-pag-title">{{ neighbors.next.label[loc] or neighbors.next.label.en }}</span></a>{%- endif %}
        </nav>
        {%- endif %}
      </article>

      <aside class="doc-toc" aria-label="{{ t.onThisPage }}"><div class="doc-toc-label">{{ t.onThisPage }}</div><nav class="doc-toc-list" data-doc-toc></nav></aside>
    </main>
  </div>

{% include "chrome/search-overlay.njk" %}
  <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js" defer></script>
  <script src="/codexmux/docs.js?v={{ site.assetVersion.docsJs }}" defer></script>
  <script src="/codexmux/site-shell.js?v={{ site.assetVersion.siteShellJs }}" defer></script>
</body>
</html>
