<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>
    (function () {
      var preference = 'auto';
      try {
        var stored = localStorage.getItem('codexmux-site-theme');
        if (stored === 'light' || stored === 'dark') preference = stored;
      } catch (_) {}
      document.documentElement.dataset.themePreference = preference;
      document.documentElement.dataset.theme = preference === 'auto'
        ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        : preference;
    })();
  </script>
{% if isRoot -%}
  <script>
    (function(){try{
      if(location.search.indexOf('nr')!==-1)return;
      var supported=['en','ko'];
      function match(locale){
        if(!locale)return null;
        if(supported.indexOf(locale)!==-1)return locale;
        var base=locale.split('-')[0];
        return supported.indexOf(base)!==-1?base:null;
      }
      var target=match(localStorage.getItem('pmx-locale'));
      if(!target){
        var languages=navigator.languages||[navigator.language||'en'];
        for(var i=0;i<languages.length;i++){var candidate=match(languages[i]);if(candidate){target=candidate;break;}}
      }
      if(target&&target!=='en')location.replace('./'+target+'/');
    }catch(_){}})();
  </script>
{%- else -%}
  <script>try{localStorage.setItem('pmx-locale','{{ lang }}');}catch(_){}</script>
{%- endif %}
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}" />
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ ogUrl }}" />
  <meta property="og:locale" content="{{ ogLocale }}" />
  <meta property="og:locale:alternate" content="{{ ogLocaleAlternate }}" />
  <meta property="og:image" content="{{ site.baseUrl }}/images/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="codexmux" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description }}" />
  <meta name="twitter:image" content="{{ site.baseUrl }}/images/og-image.png" />
  <link rel="canonical" href="{{ canonical }}" />
{%- for loc in site.locales %}
  <link rel="alternate" hreflang="{{ loc.hreflang }}" href="{{ site.baseUrl }}{{ loc.path }}" />
{%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.baseUrl }}/" />
  <link rel="icon" href="{{ assetPrefix }}images/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="{{ assetPrefix }}images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="{{ assetPrefix }}images/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="{{ assetPrefix }}images/apple-touch-icon.png" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f8f6" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0e0f" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" />
  <link rel="stylesheet" href="{{ assetPrefix }}style.css?v={{ site.assetVersion.css }}" />
  <link rel="stylesheet" href="{{ assetPrefix }}style-docs.css?v={{ site.assetVersion.docsCss }}" />
