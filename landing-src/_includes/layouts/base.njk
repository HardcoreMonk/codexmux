<body class="site-body">
{%- set shellLocale = lang or 'en' %}
{%- set shellIsDocs = false %}
{%- set shellSearchLabel = 'Search documentation' if shellLocale == 'en' else '문서 검색' %}
{%- set shellSearchPlaceholder = 'Search guides and reference…' if shellLocale == 'en' else '가이드와 레퍼런스 검색…' %}
{%- set shellSearchResultsLabel = 'Search results' if shellLocale == 'en' else '검색 결과' %}
{%- set shellNavigateLabel = 'Navigate' if shellLocale == 'en' else '이동' %}
{%- set shellOpenLabel = 'Open' if shellLocale == 'en' else '열기' %}
{%- set shellCloseLabel = 'Close' if shellLocale == 'en' else '닫기' %}
{%- if shellLocale == 'en' or shellLocale == 'ko' %}
{% include "chrome/site-header.njk" %}
{%- endif %}
{{ content | safe }}

  <footer class="site-footer">
    <div class="site-footer-brand">
      <span class="site-brand"><svg class="site-brand-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg><span><strong>codex</strong>mux</span></span>
      <span>{% if lang == 'ko' %}세션 운영 · 프로젝트 거버넌스{% else %}Session operations · Project governance{% endif %}</span>
    </div>
    <nav aria-label="Footer">
      <a href="{% if lang and lang != 'en' %}/codexmux/{{ lang }}/docs/{% else %}/codexmux/docs/{% endif %}">Docs</a>
      <a href="https://github.com/HardcoreMonk/codexmux" target="_blank" rel="noopener">GitHub</a>
      <a href="https://github.com/HardcoreMonk/codexmux/releases" target="_blank" rel="noopener">Releases</a>
      <a href="https://github.com/HardcoreMonk/codexmux/blob/main/README.md" target="_blank" rel="noopener">MIT License</a>
    </nav>
  </footer>

{%- if shellLocale == 'en' or shellLocale == 'ko' %}
{% include "chrome/search-overlay.njk" %}
  <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js" defer></script>
  <script src="{{ assetPrefix }}docs.js?v={{ site.assetVersion.docsJs }}" defer></script>
  <script src="{{ assetPrefix }}site-shell.js?v={{ site.assetVersion.siteShellJs }}" defer></script>
{%- endif %}
  <script src="{{ assetPrefix }}download.js?v={{ site.assetVersion.downloadJs }}" defer></script>
</body>
</html>
